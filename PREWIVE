-- Риг: суставы Motor6D + оси, выровненные по корню (X вправо, Y вверх, -Z вперёд)
----------------------------------------------------------------------------------------------------
local function buildRig(model, root)
    local motors = {}
    for _, m in ipairs(model:GetDescendants()) do
        if m:IsA("Motor6D") and m.Part0 and m.Part1 and m.Part0 ~= m.Part1 then
            table.insert(motors, m)
        end
    end
    local rest = { [root] = ID } -- поза покоя детали относительно корня
    local joints, list, used = {}, {}, {}
    local progress = true
    while progress do
        progress = false
        for _, m in ipairs(motors) do
            if not used[m] then
                local p0, p1 = m.Part0, m.Part1
                local j
                if rest[p0] and not rest[p1] then
                    local jf = rest[p0] * m.C0
                    rest[p1] = jf * m.C1:Inverse()
                    j = { motor = m, part = p1, parent = p0, Q = jf.Rotation, pivot = jf.Position, reversed = false }
                elseif rest[p1] and not rest[p0] then
                    local jf = rest[p1] * m.C1
                    rest[p0] = jf * m.C0:Inverse()
                    j = { motor = m, part = p0, parent = p1, Q = jf.Rotation, pivot = jf.Position, reversed = true }
                elseif rest[p0] and rest[p1] then
                    used[m] = true
                end
                if j then
                    j.Qi = j.Q:Inverse()
                    j.name = j.part.Name
                    used[m] = true
                    progress = true
                    if not joints[j.name] then joints[j.name] = j end
                    table.insert(list, j)
                end
            end
        end
    end
    return { joints = joints, list = list, rest = rest, root = root }
end

-- R — поворот в осях корня; возвращает значение для Motor6D.Transform
local function toRaw(j, R)
    if j.reversed then return j.Qi * R:Inverse() * j.Q end
    return j.Qi * R * j.Q
end

-- Если в модели нет Motor6D — собираем риг сами по именам костей
local DEFAULT_TREE = {
    { "LowerTorso", "HumanoidRootPart" }, { "SpringTorso", "LowerTorso" }, { "Head", "SpringTorso" },
    { "LeftArm", "SpringTorso" }, { "LeftArmLower", "LeftArm" }, { "HandLeft", "LeftArmLower" },
    { "RightArm", "SpringTorso" }, { "RightArmLower", "RightArm" }, { "HandRight", "RightArmLower" },
    { "LeftLeg", "LowerTorso" }, { "LeftLowerLeg", "LeftLeg" }, { "KneecapLeft", "LeftLowerLeg" },
    { "RightLeg", "LowerTorso" }, { "RightLowerLeg", "RightLeg" }, { "Fire Axe", "HandRight" },
}
local function ensureMotors(model, root)
    local count = 0
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("Motor6D") then count += 1 end
    end
    if count >= 6 then return end
    warn("[Springtrap] в модели нет Motor6D — собираю риг по именам костей")
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("JointInstance") or d:IsA("WeldConstraint") then d:Destroy() end
    end
    local rot = root.CFrame.Rotation
    for _, pair in ipairs(DEFAULT_TREE) do
        local child, parent = findPart(model, pair[1]), findPart(model, pair[2])
        if child and parent then
            local lp = child.CFrame:PointToObjectSpace(parent.Position)
            local h = child.Size / 2
            lp = V3(math.clamp(lp.X, -h.X, h.X), math.clamp(lp.Y, -h.Y, h.Y), math.clamp(lp.Z, -h.Z, h.Z))
            local jf = CFrame.new(child.CFrame:PointToWorldSpace(lp)) * rot
            local m = Instance.new("Motor6D")
            m.Name = pair[1]
            m.Part0, m.Part1 = parent, child
            m.C0, m.C1 = parent.CFrame:ToObjectSpace(jf), child.CFrame:ToObjectSpace(jf)
            m.Parent = parent
        end
    end
end

-- Сделать модель толще: растягиваем детали и суставы по горизонтали (оси X/Z корня)
local function fatten(model, root, w)
    if not w or math.abs(w - 1) < 0.01 then return end
    local rootCF = root.CFrame
    local factors = {}
    local function f(d) return math.sqrt((w * d.X) ^ 2 + d.Y ^ 2 + (w * d.Z) ^ 2) end
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            local rel = rootCF:ToObjectSpace(p.CFrame)
            factors[p] = V3(f(rel.XVector), f(rel.YVector), f(rel.ZVector))
        end
    end
    for p, k in pairs(factors) do
        if p ~= root then
            p.Size = p.Size * k
            for _, m in ipairs(p:GetChildren()) do
                if m:IsA("SpecialMesh") and m.MeshType == Enum.MeshType.FileMesh then m.Scale = m.Scale * k end
            end
        end
    end
    for _, j in ipairs(model:GetDescendants()) do
        if j:IsA("JointInstance") then
            local k0, k1 = j.Part0 and factors[j.Part0], j.Part1 and factors[j.Part1]
            if k0 then j.C0 = CFrame.new(j.C0.Position * k0) * j.C0.Rotation end
            if k1 then j.C1 = CFrame.new(j.C1.Position * k1) * j.C1.Rotation end
        end
    end
end

