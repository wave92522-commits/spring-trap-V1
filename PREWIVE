local function runAbility(ab)
    if busy or not Morph then return end
    if (cooldowns[ab] or 0) > os.clock() then return end
    busy = true
    abilityToken += 1
    local ctx = { hooks = {}, clones = {} }
    runCtx = ctx
    task.spawn(function()
        local ok, err = pcall(ab.fn)
        if not ok and err ~= CANCEL then warn("[Springtrap] " .. ab.name .. ": " .. tostring(err)) end
        for h in pairs(ctx.hooks) do unhook(h) end
        for _, c in ipairs(ctx.clones) do
            if not c.released then -- способность прервалась — отпускаем и скоро возвращаем цель
                pcall(c.release, c, ZERO)
                pcall(finish, c, false, 5)
            end
        end
        override, overrideBody = nil, nil
        setFrozen(false)
        cooldowns[ab] = os.clock() + ab.cd
        busy = false
    end)
end

