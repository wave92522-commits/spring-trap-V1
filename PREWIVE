local hidden = {}  -- [настоящий персонаж] = {restore, reapply, clone, returnAt, lethal}
local hpRec = {}   -- [настоящий персонаж] = {v, bb, fill, root}
local runCtx, busy = nil, false

local function hpOf(t)
    local r = hpRec[t.char]
    if not r then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(4, 0, 0.45, 0)
        bb.StudsOffsetWorldSpace = V3(0, 3.6, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = t.root
        bb.Enabled = false
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        bg.BorderSizePixel = 0
        bg.Parent = bb
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(1, 0, 1, 0)
        fill.BorderSizePixel = 0
        fill.Parent = bg
        bb.Parent = FX
        r = { v = CONFIG.MaxHP, bb = bb, fill = fill, root = t.root }
