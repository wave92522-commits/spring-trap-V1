local gui
local function buildUI()
    local show = CONFIG.ShowButtons == true or (CONFIG.ShowButtons == "auto" and UIS.TouchEnabled)
    if not show then return end
    gui = Instance.new("ScreenGui")
    gui.Name = "SpringtrapUI"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 50
    local parented = false
    if typeof(gethui) == "function" then
        parented = pcall(function() gui.Parent = gethui() end)
    end
    if not parented then
        parented = pcall(function() gui.Parent = game:GetService("CoreGui") end)
    end
    if not parented then gui.Parent = LP:WaitForChild("PlayerGui") end

    local frame = Instance.new("Frame")
    frame.AnchorPoint = Vector2.new(1, 0.5)
    frame.Position = UDim2.new(1, -8, 0.42, 0)
    frame.Size = UDim2.new(0, 3 * 70, 0, 2 * 70)
    frame.BackgroundTransparency = 1
    frame.Parent = gui
    local grid = Instance.new("UIGridLayout")
    grid.CellSize = UDim2.new(0, 64, 0, 64)
    grid.CellPadding = UDim2.new(0, 6, 0, 6)
    grid.FillDirectionMaxCells = 3
    grid.HorizontalAlignment = Enum.HorizontalAlignment.Right
    grid.SortOrder = Enum.SortOrder.LayoutOrder
    grid.Parent = frame

    local function button(text, order)
        local b = Instance.new("TextButton")
        b.Text = text
        b.LayoutOrder = order
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.TextWrapped = true
        b.TextColor3 = Color3.fromRGB(200, 255, 180)
        b.BackgroundColor3 = Color3.fromRGB(28, 36, 22)
        b.BackgroundTransparency = 0.25
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = b
        b.Parent = frame
        return b
    end

    local btns = {}
    for i, ab in ipairs(Abilities) do
        local b = button(ab.key and (ab.key.Name .. "\n" .. ab.name) or ab.name:upper(), i)
        bind(b.MouseButton1Down, function() runAbility(ab) end)
        btns[ab] = b
    end
    local runBtn = button("БЕГ", 100)
    bind(runBtn.MouseButton1Down, function()
        setSprint(not sprinting)
        runBtn.BackgroundColor3 = sprinting and Color3.fromRGB(70, 110, 40) or Color3.fromRGB(28, 36, 22)
    end)

    local toggle = Instance.new("TextButton")
    toggle.Text = "≡"
    toggle.Font = Enum.Font.GothamBold
    toggle.TextSize = 18
    toggle.TextColor3 = Color3.fromRGB(200, 255, 180)
    toggle.BackgroundColor3 = Color3.fromRGB(28, 36, 22)
    toggle.BackgroundTransparency = 0.25
    toggle.AnchorPoint = Vector2.new(1, 0)
    toggle.Position = UDim2.new(1, -8, 0, 8)
    toggle.Size = UDim2.new(0, 34, 0, 34)
    toggle.Parent = gui
    bind(toggle.MouseButton1Down, function() frame.Visible = not frame.Visible end)

    task.spawn(function()
        while gui.Parent do
            local now = os.clock()
            for ab, b in pairs(btns) do
                b.TextTransparency = ((cooldowns[ab] or 0) > now) and 0.6 or 0
            end
            task.wait(0.1)
        end
    end)
end

