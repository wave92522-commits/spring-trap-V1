-- Анимации из AnimSaves (KeyframeSequence) — свой проигрыватель
----------------------------------------------------------------------------------------------------
local ModelAnims = {} -- Idle / Walk / Run -> {tracks, length}
local animsPrinted = false

local function parseKFS(kfs, scale)
    local kfList = {}
    for _, kf in ipairs(kfs:GetChildren()) do
        if kf:IsA("Keyframe") then table.insert(kfList, kf) end
    end
    if #kfList < 2 then return nil end
    table.sort(kfList, function(a, b) return a.Time < b.Time end)
    local tracks, length = {}, 0
    for _, kf in ipairs(kfList) do
        length = math.max(length, kf.Time)
        for _, p in ipairs(kf:GetDescendants()) do
            if p:IsA("Pose") and p.Weight > 0 then
                local tr = tracks[p.Name]
                if not tr then tr = {}; tracks[p.Name] = tr end
                local cf = p.CFrame
                table.insert(tr, { t = kf.Time, cf = CFrame.new(cf.Position * scale) * cf.Rotation })
            end
        end
    end
    return { tracks = tracks, length = math.max(length, 0.05), name = kfs.Name }
end

local function sampleKFS(anim, name, t)
    local tr = anim.tracks[name]
    if not tr then return nil end
    local n = #tr
    if n == 1 or t <= tr[1].t then return tr[1].cf end
    if t >= tr[n].t then return tr[n].cf end
    local lo, hi = 1, n
    while hi - lo > 1 do
        local mid = (lo + hi) // 2
        if tr[mid].t <= t then lo = mid else hi = mid end
    end
    local a, b = tr[lo], tr[hi]
    return a.cf:Lerp(b.cf, (t - a.t) / math.max(b.t - a.t, 1e-4))
end

local function loadModelAnims(scale)
    table.clear(ModelAnims)
    if not CONFIG.UseModelAnims then return end
    local saves = template:FindFirstChild("AnimSaves", true)
    if not saves then return end
    local all = {}
    for _, k in ipairs(saves:GetDescendants()) do
        if k:IsA("KeyframeSequence") then table.insert(all, k) end
    end
    if not animsPrinted then
        animsPrinted = true
        print(("[Springtrap] анимаций в AnimSaves: %d"):format(#all))
        for _, k in ipairs(all) do print("      " .. k.Name) end
    end
    local function pick(exact, keys)
        if exact then
            for _, k in ipairs(all) do
                if k.Name == exact then return k end
            end
            return nil
        end
        for _, key in ipairs(keys) do
            for _, k in ipairs(all) do
                if k.Name:lower():find(key, 1, true) then return k end
            end
        end
    end
    local map = {
        Idle = pick(CONFIG.Anim.Idle, { "idle", "stand" }),
        Walk = pick(CONFIG.Anim.Walk, { "walk" }),
        Run  = pick(CONFIG.Anim.Run, { "run", "sprint", "chase" }),
    }
    for state, k in pairs(map) do
        local ok, anim = pcall(parseKFS, k, scale)
        if ok and anim then ModelAnims[state] = anim end
    end
end

