local hooks, stepHooks = {}, {}
local abilityToken = 0
local cooldowns = {}

local function W(t)
    local tok = abilityToken
    task.wait(t)
    if tok ~= abilityToken or not Morph then error(CANCEL) end
end

local function hook(fn, stepped)
    local tbl = stepped and stepHooks or hooks
    tbl[fn] = true
    if runCtx then runCtx.hooks[fn] = true end
    return fn
end
local function unhook(fn)
    if fn then hooks[fn], stepHooks[fn] = nil, nil end
end

local function setFrozen(v)
    if not Morph or frozen == v then return end
    frozen = v
    local hum = Morph.hum
    if v then
        if not sprinting then baseSpeed = hum.WalkSpeed > 0 and hum.WalkSpeed or baseSpeed end
        Morph.savedJP, Morph.savedJH = hum.JumpPower, hum.JumpHeight
        hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = 0, 0, 0
    else
        hum.WalkSpeed = sprinting and CONFIG.RunSpeed or baseSpeed
        hum.JumpPower, hum.JumpHeight = Morph.savedJP or hum.JumpPower, Morph.savedJH or hum.JumpHeight
    end
end

local function setSprint(v)
    if sprinting == v then return end
    sprinting = v
    if not Morph or frozen then return end
    local hum = Morph.hum
    if v then
        baseSpeed = hum.WalkSpeed > 0 and hum.WalkSpeed or baseSpeed
        hum.WalkSpeed = CONFIG.RunSpeed
    else
        hum.WalkSpeed = baseSpeed
    end
end

-- Поза: gr/ot = рука хвата / вторая: {подъём вперёд, внутрь, в сторону, локоть}
--       spine = {наклон назад, поворот по ходу броска, вбок}, head = {вверх, вбок, наклон}
local function mk(s)
    local p = {}
    local function setArm(side, a)
        p[side .. "Arm"] = arm(rad(a[1]), rad(a[2] or 0), rad(a[3] or 0), SGN[side])
        p[side .. "ArmLower"] = A(rad(a[4] or 0), 0, 0)
    end
    if s.gr then setArm(GR, s.gr) end
    if s.ot then setArm(OT, s.ot) end
    if s.spine then p.Spine = A(rad(s.spine[1]), rad((s.spine[2] or 0) * SGN[GR]), rad(s.spine[3] or 0)) end
    if s.head then p.Head = A(rad(s.head[1]), rad(s.head[2] or 0), rad(s.head[3] or 0)) end
    p.Body = s.body
    return p
end

local function setPose(logical, speed)
    local raw, body = expand(logical)
    override, overrideBody, overrideSpeed = raw, body, speed or 12
end
local function P(spec, speed) setPose(mk(spec), speed) end

local function findTargets(range, minDot, maxN)
    local o, look = Morph.hrp.Position, flat(Morph.hrp.CFrame.LookVector)
    local res = {}
    for _, t in ipairs(allTargets()) do
        local d = t.root.Position - o
        local dist = d.Magnitude
        if dist <= range and (dist < 3 or flat(d):Dot(look) >= minDot) then
            t.dist = dist
            table.insert(res, t)
        end
    end
    table.sort(res, function(a, b) return a.dist < b.dist end)
    if maxN then
        for i = #res, maxN + 1, -1 do res[i] = nil end
    end
    return res
end

-- клон держится шеей в руке. mode "up" — висит лицом к тебе, "club" — тело вытянуто вдоль руки
local function hold(c)
    local head = c.head
    local rel = (head and c.rig.rest[head]) and (c.rig.rest[head].Position - V3(0, head.Size.Y * 0.4, 0)) or V3(0, 1.5, 0)
    return hook(function(dt)
        local M = Morph
        if not M or not c.model.Parent or c.released then return end
        local handPos = M.handGR.Position
        local rot
        if c.mode == "club" then
            local dir = handPos - M.foreGR.Position
            dir = dir.Magnitude > 0.05 and dir.Unit or V3(0, -1, 0)
            local up = -dir
            local right = up:Cross(M.hrp.CFrame.LookVector)
            right = right.Magnitude > 0.05 and right.Unit or M.hrp.CFrame.RightVector
            rot = CFrame.fromMatrix(ZERO, right, up)
        else
            rot = (M.hrp.CFrame * A(0, math.pi, 0)).Rotation
        end
        if c.jitter > 0 then
            rot = rot * A(rad(rnd(-c.jitter, c.jitter)), 0, rad(rnd(-c.jitter, c.jitter)))
        end
        local target = CFrame.new(handPos - rot:VectorToWorldSpace(rel)) * rot
        c.root.CFrame = c.root.CFrame:Lerp(target, math.min(1, dt * c.follow))
    end)
end

-- цель дёргается в руке
local function struggle(c)
    local t0 = os.clock()
    return hook(function()
        local t = os.clock() - t0
        for i, j in ipairs(c.arms) do
            if j.motor.Parent then j.motor.Transform = toRaw(j, A(rad(150) + rad(14) * math.sin(t * 19 + i * 2), 0, 0)) end
        end
        for i, j in ipairs(c.legs) do
            if j.motor.Parent then j.motor.Transform = toRaw(j, A(rad(28) * math.sin(t * 15 + i * math.pi), 0, 0)) end
        end
    end, true)
end

local function limp(c)
    for _, j in ipairs(c.arms) do
        if j.motor.Parent then j.motor.Transform = toRaw(j, A(rad(8), 0, 0)) end
    end
    for _, j in ipairs(c.legs) do
        if j.motor.Parent then j.motor.Transform = ID end
    end
end

-- общий старт всех захватов: тянется рукой, хватает ближайшую цель перед собой
local function grabStart()
    local t = findTargets(Morph.reach, 0.2, 1)[1]
    P({ gr = { 80, 5, 5, 10 }, spine = { -8, 10 } }, 16)
    W(0.2)
    local c = grab(t)
    if not c then
        W(0.25)
        return nil
    end
    setFrozen(true)
    c.hHold, c.hStr = hold(c), struggle(c)
    return c
end

local function look() return flat(Morph.hrp.CFrame.LookVector) end

