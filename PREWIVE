local Morph = nil
local GR, OT = "Right", "Left"         -- рука, которой хватает / вторая
local SGN = { Right = 1, Left = -1 }
local fix, spineMode = {}, "A"

local cur, bodyCur = {}, ID
local override, overrideBody, overrideSpeed = nil, nil, 12
local phase, animT, kTime, runAmt = 0, 0, 0, 0
local nextTwitch, twitchEnd, twitchVal = 3, 0, 0
local sprinting, frozen, baseSpeed = false, false, 16
local hiddenOwn = {}
local savedCam = {}

local function arm(pitch, yawIn, out, side)
    return A(0, yawIn * side, 0) * A(pitch, 0, 0) * A(0, 0, out * side)
end

local function expand(L)
    local rig = Morph.rig
    local raw = {}
    for name, R in pairs(L) do
        if name == "Spine" then
            local j = rig.joints.SpringTorso
            if j then raw.SpringTorso = toRaw(j, R) end
            if spineMode == "B" and rig.joints.LowerTorso then
                raw.LowerTorso = toRaw(rig.joints.LowerTorso, R:Inverse())
            end
        elseif name ~= "Body" then
            local j = rig.joints[name]
            if j then raw[name] = toRaw(j, R * (fix[name] or ID)) end
        end
    end
    return raw, L.Body
end

local function procLoco(t, ph, mv, run, air)
    local s, c = math.sin(ph), math.cos(ph)
    local L = {}
    if air then
        L.LeftLeg, L.RightLeg = A(rad(22), 0, 0), A(rad(-12), 0, 0)
        L.LeftLowerLeg, L.RightLowerLeg = A(rad(-35), 0, 0), A(rad(-20), 0, 0)
        L.LeftArm, L.RightArm = arm(rad(-10), 0, rad(28), -1), arm(rad(-10), 0, rad(28), 1)
        L.LeftArmLower, L.RightArmLower = A(rad(20), 0, 0), A(rad(20), 0, 0)
        L.Spine = A(rad(-6), 0, 0)
        return L
    end
    local idle = 1 - mv
    local legSw = rad(lerp(24, 46, run)) * mv
    local knee = rad(lerp(40, 80, run)) * mv
    local armSw = rad(lerp(16, 42, run)) * mv
    local elbow = rad(10 + lerp(8, 55, run) * mv)
    local lean = rad(4 + lerp(4, 15, run) * mv + 1.5 * math.sin(t * 1.4) * idle)
    L.LeftLeg, L.RightLeg = A(legSw * s, 0, 0), A(-legSw * s, 0, 0)
    L.LeftLowerLeg = A(-knee * math.max(0, c) - rad(3), 0, 0)
    L.RightLowerLeg = A(-knee * math.max(0, -c) - rad(3), 0, 0)
    L.LeftArm, L.RightArm = arm(-armSw * s, 0, rad(9), -1), arm(armSw * s, 0, rad(9), 1)
    L.LeftArmLower, L.RightArmLower = A(elbow, 0, 0), A(elbow, 0, 0)
    L.Spine = A(-lean, rad(5) * s * mv, rad(2.5) * c * mv) -- тяжёлая походка: корпус качается
    L.Head = A(lean * 0.7, rad(7) * math.sin(t * 0.5) * idle, (t < twitchEnd) and twitchVal or 0)
    local bob = (0.06 + 0.1 * run) * (Morph.height / 7) * mv * (0.5 - 0.5 * math.cos(ph * 2))
    L.Body = CFrame.new(0, -bob, 0)
    return L
end

local function updateAnim(dt)
    local M = Morph
    local vel = M.hrp.AssemblyLinearVelocity
    local speed = V3(vel.X, 0, vel.Z).Magnitude
    local air = M.hum.FloorMaterial == Enum.Material.Air
    local mv = math.clamp(speed / 6, 0, 1)
    runAmt += (((sprinting and speed > 18) and 1 or 0) - runAmt) * math.min(1, dt * 6)
    phase += dt * speed * lerp(0.42, 0.3, runAmt) * (7 / M.height)
    animT += dt
    if animT > nextTwitch then
        twitchEnd, twitchVal, nextTwitch = animT + 0.12, rad(rnd(-20, 20)), animT + rnd(2.5, 6)
    end

    local raw, body
    local state = (mv < 0.15) and "Idle" or (runAmt > 0.5 and "Run" or "Walk")
    local anim = ModelAnims[state] or (state == "Run" and ModelAnims.Walk) or nil
    if anim and not air then
        local rate = 1
        if state ~= "Idle" then
            local ref = (state == "Run" and ModelAnims.Run) and CONFIG.RunSpeed or 16
            rate = math.clamp(speed / ref, 0.5, 2.2)
        end
        kTime = (kTime + dt * rate) % anim.length
        raw = {}
        for name in pairs(M.rig.joints) do
            raw[name] = sampleKFS(anim, name, kTime)
        end
    else
        raw, body = expand(procLoco(animT, phase, mv, runAmt, air))
    end

    local aLoco = 1 - math.exp(-dt * 16)
    local aOv = 1 - math.exp(-dt * overrideSpeed)
    for name, j in pairs(M.rig.joints) do
        local target, a
        if override and override[name] then
            target, a = override[name], aOv
        else
            target, a = raw[name] or ID, aLoco
        end
        local c = (cur[name] or ID):Lerp(target, a)
        cur[name] = c
        j.motor.Transform = c
    end
    if override and overrideBody then
        bodyCur = bodyCur:Lerp(overrideBody, aOv)
    else
        bodyCur = bodyCur:Lerp(body or ID, aLoco)
    end
    M.mount.C0 = M.baseMount * bodyCur
end

local function hideOwn(char)
    local function h(d)
        if d:FindFirstAncestorOfClass("Tool") then return end
        if (d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture")) and hiddenOwn[d] == nil then
            hiddenOwn[d] = d.Transparency
            d.Transparency = 1
        end
    end
    for _, d in ipairs(char:GetDescendants()) do h(d) end
    bind(char.DescendantAdded, h, morphConns)
end

local function destroyMorph()
    disconnectAll(morphConns)
    for inst, tr in pairs(hiddenOwn) do
        pcall(function() inst.Transparency = tr end)
    end
    table.clear(hiddenOwn)
    if Morph then
        pcall(function()
            Morph.hum.CameraOffset = savedCam.offset or ZERO
            if frozen or sprinting then Morph.hum.WalkSpeed = baseSpeed end
            if frozen then
                Morph.hum.JumpPower = Morph.savedJP or Morph.hum.JumpPower
                Morph.hum.JumpHeight = Morph.savedJH or Morph.hum.JumpHeight
            end
        end)
        if savedCam.max then
            pcall(function() LP.CameraMaxZoomDistance = savedCam.max; LP.CameraMode = savedCam.mode end)
        end
        Morph.model:Destroy()
    end
    Morph = nil
    override, overrideBody = nil, nil
    frozen, sprinting = false, false
    table.clear(cur)
    bodyCur = ID
end

local function createMorph(char)
    destroyMorph()
    local hum = char:WaitForChild("Humanoid", 10)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not (hum and hrp) then return end
    refreshRayFilter()

    local model = template:Clone()
    model.Name = "SpringtrapMorph"
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("Humanoid") or d:IsA("LuaSourceContainer") or d.Name == "AnimSaves" or d:IsA("BodyMover")
            or d:IsA("Sound") or d:IsA("Animator") or d:IsA("AnimationController") then
            d:Destroy()
        end
    end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart

    -- топор
    local axe
    for _, d in ipairs(model:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Model") or d:IsA("Tool")) and d.Name:lower():find("axe") then
            axe = d
            break
        end
    end
    local axeParts = {}
    if axe then
        if axe:IsA("BasePart") then table.insert(axeParts, axe) end
        for _, d in ipairs(axe:GetDescendants()) do
            if d:IsA("BasePart") then table.insert(axeParts, d) end
        end
        if not CONFIG.ShowAxe or #axeParts == 0 then
            axe:Destroy()
            axe, axeParts = nil, {}
        end
    end
    local axeMain = axeParts[1]
    local isAxe = {}
    for _, p in ipairs(axeParts) do isAxe[p] = true end

    -- габариты в осях корня
    local function extents()
        local minY, maxY = math.huge, -math.huge
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") and p ~= root and not isAxe[p] then
                local rel = root.CFrame:ToObjectSpace(p.CFrame)
                local s = p.Size
                local hy = 0.5 * (math.abs(rel.XVector.Y) * s.X + math.abs(rel.YVector.Y) * s.Y + math.abs(rel.ZVector.Y) * s.Z)
                minY, maxY = math.min(minY, rel.Position.Y - hy), math.max(maxY, rel.Position.Y + hy)
            end
        end
        return minY, maxY
    end
    local minY, maxY = extents()
    local scale = 1
    if CONFIG.Height and maxY > minY then
        scale = CONFIG.Height / (maxY - minY)
        local ok = pcall(function() model:ScaleTo(model:GetScale() * scale) end)
        if ok then minY, maxY = extents() else scale = 1 end
    end
    loadModelAnims(scale)

    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, false, true
        end
    end
    root.Transparency = 1

    ensureMotors(model, root)

    local function hand(side)
        return findPart(model, "Hand" .. side) or findPart(model, side .. "ArmLower")
            or findPart(model, side .. "Arm") or root
    end

    -- в какой руке топор; если он ни к чему не прикреплён — крепим к ближайшей кисти
    local axeSide = nil
    if axeMain then
        local l, r = hand("Left"), hand("Right")
        local dl, dr = (axeMain.Position - l.Position).Magnitude, (axeMain.Position - r.Position).Magnitude
        axeSide = dl < dr and "Left" or "Right"
        local wasHidden = false
        for _, p in ipairs(axeParts) do
            if p.Transparency >= 0.99 then
                p.Transparency = 0
                wasHidden = true
            end
        end
        local attachedTo
        for _, d in ipairs(model:GetDescendants()) do
            if (d:IsA("JointInstance") or d:IsA("WeldConstraint")) and d.Part0 and d.Part1
                and (isAxe[d.Part0] ~= isAxe[d.Part1]) then
                attachedTo = isAxe[d.Part0] and d.Part1 or d.Part0
                break
            end
        end
        if not attachedTo then
            local h = hand(axeSide)
            if math.min(dl, dr) < (maxY - minY) * 0.4 then
                local wc = Instance.new("WeldConstraint")
                wc.Part0, wc.Part1 = h, axeMain
                wc.Parent = axeMain
            else
                local w = Instance.new("Weld")
                w.Part0, w.Part1 = h, axeMain
                w.Parent = axeMain
            end
            attachedTo = h
        end
        print(("[Springtrap] топор: найден (%s), был невидимым: %s, прикреплён к %s"):format(
            axeMain.Name, tostring(wasHidden), attachedTo.Name))
    else
        print("[Springtrap] топор: " .. (CONFIG.ShowAxe and "в модели не найден" or "отключён в CONFIG"))
    end

    fatten(model, root, CONFIG.Thickness)
    local rig = buildRig(model, root)

    -- детали, не привязанные к ригу — привариваем к ближайшей кости
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") and not rig.rest[p] and not isAxe[p] then
            local attached = false
            for _, d in ipairs(model:GetDescendants()) do
                if (d:IsA("JointInstance") or d:IsA("WeldConstraint")) and (d.Part0 == p or d.Part1 == p) and d.Part0 and d.Part1 then
                    attached = true
                    break
                end
            end
            if not attached then
                local best, bd = root, math.huge
                for q in pairs(rig.rest) do
                    local d = (q.Position - p.Position).Magnitude
                    if q ~= root and d < bd then best, bd = q, d end
                end
                local wc = Instance.new("WeldConstraint")
                wc.Part0, wc.Part1 = best, p
                wc.Parent = p
            end
        end
    end

    -- хватает свободной рукой (той, где нет топора)
    GR = (axeSide == "Right") and "Left" or "Right"
    OT = (GR == "Right") and "Left" or "Right"

    -- поправка T-позы: считаем, что в покое руки/ноги должны смотреть вниз
    table.clear(fix)
    local function calcFix(name, childName)
        local j, cj = rig.joints[name], rig.joints[childName]
        if not j then return end
        local dir = (cj and cj.pivot or rig.rest[j.part].Position) - j.pivot
        if dir.Magnitude < 0.05 then return end
        dir = dir.Unit
        local down = V3(0, -1, 0)
        local ang = math.acos(math.clamp(dir:Dot(down), -1, 1))
        local axis = dir:Cross(down)
        if ang > rad(35) and axis.Magnitude > 1e-3 then
            fix[name] = CFrame.fromAxisAngle(axis.Unit, ang)
        end
    end
    calcFix("LeftArm", "LeftArmLower"); calcFix("RightArm", "RightArmLower")
    calcFix("LeftLeg", "LeftLowerLeg"); calcFix("RightLeg", "RightLowerLeg")

    local jC, jL = rig.joints.SpringTorso, rig.joints.LowerTorso
    spineMode = (jC and jC.parent.Name == "LowerTorso") and "A" or ((jL and jL.parent.Name == "SpringTorso") and "B" or "A")

    -- посадка на персонажа: ступни морфа на уровне пола
    local groundDist = hrp.Size.Y / 2 + hum.HipHeight
    if hum.RigType == Enum.HumanoidRigType.R6 then
        local leg = char:FindFirstChild("Left Leg")
        groundDist += leg and leg.Size.Y or 2
    end
    local baseMount = CFrame.new(0, -groundDist - minY, 0) * A(0, rad(CONFIG.YawFix), 0)
    local mount = Instance.new("Weld")
    mount.Name = "MorphMount"
    mount.Part0, mount.Part1, mount.C0 = hrp, root, baseMount
    mount.Parent = root
    model.Parent = FX

    savedCam.offset = hum.CameraOffset
    local camY = math.max(0, baseMount.Position.Y + maxY - 2.1) -- камера на уровне глаз морфа
    if CONFIG.ThirdPerson then
        savedCam.max, savedCam.mode = LP.CameraMaxZoomDistance, LP.CameraMode
        pcall(function()
            LP.CameraMode = Enum.CameraMode.Classic
            LP.CameraMaxZoomDistance = math.max(LP.CameraMaxZoomDistance, 45)
        end)
    end

    baseSpeed = hum.WalkSpeed > 0 and hum.WalkSpeed or 16
    local height = maxY - minY
    Morph = {
        model = model, rig = rig, root = root, mount = mount, baseMount = baseMount,
        char = char, hum = hum, hrp = hrp, head = findPart(model, "Head"),
        handGR = hand(GR),
        foreGR = findPart(model, GR .. "ArmLower") or findPart(model, GR .. "Arm") or root,
        height = height, reach = math.max(10, height * 1.3), camOffset = V3(0, camY, 0),
    }

    hideOwn(char)
    bind(hum.Died, function() destroyMorph() end, morphConns)
    print(("[Springtrap] морф готов: суставов %d, рост %.1f, хватает %s рукой"):format(
        #rig.list, height, GR == "Right" and "правой" or "левой"))
end

