bind(RunService.Stepped, function(_, dt)
    if not Morph then return end
    local ok, err = pcall(updateAnim, dt)
    if not ok then warn("[Springtrap] anim: " .. tostring(err)) end
    for fn in pairs(table.clone(stepHooks)) do
        local ok2, e2 = pcall(fn, dt)
        if not ok2 then stepHooks[fn] = nil; warn("[Springtrap] hook: " .. tostring(e2)) end
    end
end)

local slowTick = 0
bind(RunService.Heartbeat, function(dt)
    for fn in pairs(table.clone(hooks)) do
        local ok, err = pcall(fn, dt)
        if not ok then hooks[fn] = nil; warn("[Springtrap] hook: " .. tostring(err)) end
    end

    slowTick += dt
    if slowTick > 0.5 then
        slowTick = 0
        local now = os.clock()
        for ch, rec in pairs(table.clone(hidden)) do
            if not ch.Parent then
                hidden[ch] = nil
                if rec.clone and rec.clone.model.Parent then rec.clone.model:Destroy() end
            elseif rec.returnAt and now > rec.returnAt then
                bringBack(ch)
            else
                rec.reapply()
            end
        end
        for ch, r in pairs(hpRec) do
            if not ch.Parent then
                r.bb:Destroy()
                hpRec[ch] = nil
            end
        end
        for inst in pairs(hiddenOwn) do
            if inst.Parent and inst.Transparency ~= 1 then inst.Transparency = 1 end
        end
    end
end)

bind(RunService.RenderStepped, function()
    if not Morph then return end
    local off = Morph.camOffset
    local now = os.clock()
    if now < shakeEnd then
        off += rng:NextUnitVector() * shakeMag * ((shakeEnd - now) / shakeDur)
    end
    Morph.hum.CameraOffset = off
    local cam = workspace.CurrentCamera
    if cam and Morph.head and Morph.head:IsA("BasePart") then
        local firstPerson = (cam.CFrame.Position - cam.Focus.Position).Magnitude < 1.2
        Morph.head.LocalTransparencyModifier = firstPerson and 1 or 0
    end
end)

