local function hideReal(char)
    if hidden[char] then return hidden[char] end
    local saved, list = {}, {}
    local function hide(d)
        if d:IsA("BasePart") then
            d.LocalTransparencyModifier = 1
        elseif d:IsA("Decal") or d:IsA("Texture") then
            saved[d] = { "Transparency", d.Transparency }
            d.Transparency = 1
        elseif d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Fire") or d:IsA("Smoke")
            or d:IsA("Sparkles") or d:IsA("Light") or d:IsA("BillboardGui") or d:IsA("SurfaceGui") or d:IsA("Highlight") then
            saved[d] = { "Enabled", d.Enabled }
            d.Enabled = false
        elseif d:IsA("Humanoid") then
            saved[d] = { "DisplayDistanceType", d.DisplayDistanceType }
            d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        elseif d:IsA("Sound") then
            saved[d] = { "Volume", d.Volume }
            d.Volume = 0
        end
    end
    for _, d in ipairs(char:GetDescendants()) do pcall(hide, d) end
    bind(char.DescendantAdded, function(d) pcall(hide, d) end, list)
    local rec = {
        returnAt = os.clock() + 120,
        reapply = function()
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") then d.LocalTransparencyModifier = 1 end
            end
        end,
        restore = function()
            disconnectAll(list)
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") then d.LocalTransparencyModifier = 0 end
            end
            for inst, pv in pairs(saved) do
                pcall(function() inst[pv[1]] = pv[2] end)
            end
        end,
    }
    hidden[char] = rec
    return rec
end

-- вернуть настоящего персонажа (появляется там, где он реально находится)
local function bringBack(char)
    local rec = hidden[char]
    if not rec then return end
    hidden[char] = nil
    pcall(rec.restore)
    if rec.clone and rec.clone.model.Parent then rec.clone.model:Destroy() end
    local r = hpRec[char]
    if r then
        if rec.lethal then r.v = CONFIG.MaxHP end
        r.bb.Adornee = r.root
        refreshBar(r)
    end
end

local function buildDummy()
    local m = Instance.new("Model")
    local skin = Color3.fromRGB(204, 170, 140)
    local function P_(name, size, color)
        local p = newPart(name, size, color)
        p.Parent = m
        return p
    end
    local function J(name, p0, p1, c0, c1)
        local j = Instance.new("Motor6D")
        j.Name, j.Part0, j.Part1, j.C0, j.C1 = name, p0, p1, c0, c1
        j.Parent = p0
    end
    local root = P_("HumanoidRootPart", V3(2, 2, 1), skin)
    root.Transparency = 1
    local torso = P_("Torso", V3(2, 2, 1), Color3.fromRGB(70, 90, 140))
    J("RootJoint", root, torso, ID, ID)
    J("Neck", torso, P_("Head", V3(1.2, 1.2, 1.2), skin), CFrame.new(0, 1, 0), CFrame.new(0, -0.6, 0))
    J("Left Shoulder", torso, P_("Left Arm", V3(1, 2, 1), skin), CFrame.new(-1, 0.9, 0), CFrame.new(0.5, 0.9, 0))
    J("Right Shoulder", torso, P_("Right Arm", V3(1, 2, 1), skin), CFrame.new(1, 0.9, 0), CFrame.new(-0.5, 0.9, 0))
    J("Left Hip", torso, P_("Left Leg", V3(1, 2, 1), Color3.fromRGB(50, 50, 60)), CFrame.new(-0.5, -1, 0), CFrame.new(0, 1, 0))
    J("Right Hip", torso, P_("Right Leg", V3(1, 2, 1), Color3.fromRGB(50, 50, 60)), CFrame.new(0.5, -1, 0), CFrame.new(0, 1, 0))
    m.PrimaryPart = root
    return m
end

local Clone = {}
Clone.__index = Clone

local function newClone(char)
    local clone
    pcall(function()
        char.Archivable = true
        for _, d in ipairs(char:GetDescendants()) do d.Archivable = true end
        clone = char:Clone()
    end)
    if not clone or not clone:FindFirstChildWhichIsA("BasePart", true) then clone = buildDummy() end
    clone.Name = "Grabbed"

    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("ForceField") or d:IsA("BodyMover")
            or d:IsA("Animator") or d:IsA("BillboardGui") or d:IsA("Highlight") or d:IsA("ProximityPrompt")
            or d:IsA("Constraint") then
            d:Destroy()
        end
    end
    local hum = clone:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
        pcall(function() hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff end)
        pcall(function() hum.BreakJointsOnDeath = false; hum.RequiresNeck = false end)
        pcall(function() hum.EvaluateStateMachine = false end)
        pcall(function() hum.PlatformStand = true; hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    end

    local root = clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
    for _, p in ipairs(clone:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored = (p == root)
            p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
            p.LocalTransparencyModifier = 0
        end
    end

    local self = setmetatable({ model = clone, root = root, mode = "up", follow = 18, jitter = 0 }, Clone)
    self.rig = buildRig(clone, root)
    local head = clone:FindFirstChild("Head")
    self.head = (head and head:IsA("BasePart")) and head or nil
    local torso = clone:FindFirstChild("UpperTorso") or clone:FindFirstChild("Torso")
    self.torso = (torso and torso:IsA("BasePart")) and torso or root
    self.arms, self.legs = {}, {}
    for _, j in ipairs(self.rig.list) do
        local n, pn = j.name:lower(), j.parent.Name:lower()
        if pn:find("torso") and not n:find("torso") and not n:find("root") then
            if n:find("head") then
                self.headJ = j
            elseif n:find("arm") then
                table.insert(self.arms, j)
            elseif n:find("leg") then
                table.insert(self.legs, j)
            end
        end
    end

    clone:PivotTo(char:GetPivot())
    clone.Parent = FX
    return self
end

function Clone:ragdoll()
    for _, j in ipairs(self.rig.list) do
        local m = j.motor
        if m.Parent and m.Part0 ~= self.root and m.Part1 ~= self.root then
            local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
            a0.CFrame, a1.CFrame = m.C0, m.C1
            a0.Parent, a1.Parent = m.Part0, m.Part1
            local bs = Instance.new("BallSocketConstraint")
            bs.Attachment0, bs.Attachment1 = a0, a1
            bs.LimitsEnabled, bs.UpperAngle = true, 55
            bs.TwistLimitsEnabled, bs.TwistLowerAngle, bs.TwistUpperAngle = true, -35, 35
            bs.Parent = m.Part0
            local nc = Instance.new("NoCollisionConstraint")
            nc.Part0, nc.Part1 = m.Part0, m.Part1
            nc.Parent = m.Part0
            m:Destroy()
        end
    end
end

-- отпустить: клон становится рэгдоллом и летит со скоростью vel
function Clone:release(vel)
    if self.released then return end
    self.released = true
    if not self.model.Parent then return end
    self:ragdoll()
    for _, p in ipairs(self.model:GetDescendants()) do
        if p:IsA("BasePart") and p ~= self.root and p.Size.Magnitude > 0.9 then
            p.CanCollide = true
        end
    end
    self.root.Anchored = false
    fling(self.torso.Parent and self.torso or self.root, vel or ZERO)
end

-- Список целей (игроки + NPC)
local npcCache, npcScanAt = {}, 0
local function allTargets()
    local list, seen = {}, {}
    local myChar = LP.Character
    local function add(model, hum)
        if seen[model] or hidden[model] or model == myChar or not model.Parent or model:IsDescendantOf(FX) then return end
        if hum.Health <= 0 then return end
        local root = hum.RootPart or model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
        if not root then return end
        seen[model] = true
        table.insert(list, { char = model, hum = hum, root = root })
    end
    if CONFIG.HitPlayers then
        for _, pl in ipairs(Players:GetPlayers()) do
            local ch = pl ~= LP and pl.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if hum then add(ch, hum) end
        end
    end
    if CONFIG.HitNPCs then
        if os.clock() - npcScanAt > 1.5 then
            npcScanAt = os.clock()
            table.clear(npcCache)
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("Humanoid") and d.Parent and d.Parent:IsA("Model") and not Players:GetPlayerFromCharacter(d.Parent) then
                    table.insert(npcCache, d)
                end
            end
        end
        for _, hum in ipairs(npcCache) do
            if hum.Parent then add(hum.Parent, hum) end
        end
    end
    return list
end

-- схватить цель: прячем настоящего, возвращаем локальный клон
local function grab(t)
    if not t or hidden[t.char] or not t.char.Parent then return nil end
    local ok, c = pcall(newClone, t.char)
    if not ok then warn("[Springtrap] клон: " .. tostring(c)) return nil end
    local rec = hideReal(t.char)
    rec.clone = c
    c.target = t
    hpOf(t).bb.Adornee = c.torso
    if runCtx and busy then table.insert(runCtx.clones, c) end
    return c
end

-- назначить, когда цель вернётся (lethal = была убита → вернётся с полным ХП)
local function finish(c, lethal, delay)
    local rec = hidden[c.target.char]
    if not rec then return end
    rec.lethal = lethal
    if delay then
        rec.returnAt = os.clock() + delay
    else
        rec.returnAt = nil
        Debris:AddItem(c.model, 300)
    end
end

