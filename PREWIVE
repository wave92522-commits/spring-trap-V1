end

local function refreshBar(r)
    local k = math.clamp(r.v / CONFIG.MaxHP, 0, 1)
    r.fill.Size = UDim2.new(k, 0, 1, 0)
    r.fill.BackgroundColor3 = Color3.fromRGB(255 * (1 - k), 40 + 180 * k, 40)
    r.bb.Enabled = r.v < CONFIG.MaxHP
end

-- снять ХП (lethal = можно до нуля; иначе минимум 1)
local function damage(t, amount, lethal)
    local r = hpOf(t)
    r.v = math.max(lethal and 0 or 1, r.v - amount)
    refreshBar(r)
    local adornee = r.bb.Adornee
    if adornee and adornee.Parent then
        local pop = Instance.new("BillboardGui")
        pop.Size = UDim2.new(3, 0, 1.1, 0)
        pop.StudsOffsetWorldSpace = V3(rnd(-1, 1), 4.6, 0)
        pop.AlwaysOnTop = true
        pop.Adornee = adornee
