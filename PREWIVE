local function discCF(pos, n)
    local ref = math.abs(n.Y) > 0.99 and V3(1, 0, 0) or UP
    local t1 = n:Cross(ref).Unit
    return CFrame.fromMatrix(pos, n, t1, n:Cross(t1)) -- ось X цилиндра = нормаль
end

-- кольцо пыли по земле
local function dustRing(pos, radius, time)
    local ray = workspace:Raycast(pos + V3(0, 2, 0), V3(0, -16, 0), rayParams)
    local p, n = ray and ray.Position or pos, ray and ray.Normal or UP
    local d = newPart("Dust", V3(0.12, 2, 2), Color3.fromRGB(175, 165, 150))
    d.Shape = Enum.PartType.Cylinder
    d.Anchored = true
    d.Transparency = 0.45
    d.CFrame = discCF(p + n * 0.1, n)
    d.Parent = FX
    TweenService:Create(d, TweenInfo.new(time or 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = V3(0.12, radius * 2, radius * 2), Transparency = 1 }):Play()
    Debris:AddItem(d, (time or 0.45) + 0.1)

    local att = Instance.new("Attachment")
    att.Parent = workspace.Terrain
    att.WorldPosition = p + n * 0.5
    local e = Instance.new("ParticleEmitter")
    e.Texture = "rbxasset://textures/particles/smoke_main.dds"
    e.Color = ColorSequence.new(Color3.fromRGB(170, 160, 145))
    e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 4) })
    e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
    e.Lifetime = NumberRange.new(0.4, 0.9)
    e.Speed = NumberRange.new(6, 14)
    e.SpreadAngle = Vector2.new(85, 85)
    e.Rotation = NumberRange.new(0, 360)
    e.Enabled = false
    e.Parent = att
    e:Emit(10)
    Debris:AddItem(att, 1.5)
end

local function fling(part, vel, ang)
    ang = ang or rng:NextUnitVector() * rnd(4, 12)
    local function apply()
        if part.Parent then
            part.AssemblyLinearVelocity = vel
            part.AssemblyAngularVelocity = ang
        end
    end
    apply()
    task.delay(0.05, apply)
end

